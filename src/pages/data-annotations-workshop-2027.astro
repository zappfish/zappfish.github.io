---
import Main from '../layouts/Main.astro'
import Hero from '../layouts/Hero.astro'
import SectionCard from '../components/ui/SectionCard.astro'
import ActionCard from '../components/ui/ActionCard.astro'
import IconCalendar from '../components/icons/IconCalendar.astro'
import IconEdit from '../components/icons/IconEdit.astro'
import IconTarget from '../components/icons/IconTarget.astro'
import IconUsers from '../components/icons/IconUsers.astro'
import IconUpload from '../components/icons/IconUpload.astro'
import IconMap from '../components/icons/IconMap.astro'
import IconFileText from '../components/icons/IconFileText.astro'
import IconMail from '../components/icons/IconMail.astro'

const registrationUrl = 'https://forms.gle/LaSLkzEyUvZGzLJo6'
---

<Main title="ZAPP Data Annotations Workshop">

    <Hero title="ZAPP Data Annotations Workshop" image="/images/events/cu-anschutz-campus.jpg" slot="hero" />

    <section class="about">
        <div class="section-label">About the Workshop</div>
        <p>Check this page often for updates, registrations, and more information as it becomes available. If you aren't already signed up, join our <a href="https://docs.google.com/forms/d/e/1FAIpQLSfJcQehTjQZQHKil_aW0eTlRVewu154UOYGDEzGGoBb0la0Kg/viewform" target="_blank" rel="noopener noreferrer">mailing list</a> to get updates directly to your mailbox.</p>
    </section>

    <section class="details">
        <SectionCard title="Workshop Details" iconColor="teal">
            <IconCalendar slot="icon" />
            {/* Scoping anchor: ensures .details-body and ul share the same Astro scope hash, preventing styles from silently dropping on SSR hard-refresh across slot boundaries. */}
            <div class="details-body">
                <ul>
                    <li><strong>Date:</strong> February 23-24, 2027</li>
                    <li><strong>Time:</strong> 9 am - 5 pm Mountain Time (both days)</li>
                    <li><strong>Location:</strong> <a href="https://www.cuanschutz.edu/" target="_blank" rel="noopener noreferrer">University of Colorado Anschutz Medical Campus</a>, Aurora, Colorado</li>
                </ul>
            </div>
        </SectionCard>
    </section>

    <section class="registration">
        <SectionCard title="Registration" iconColor="teal">
            <IconEdit slot="icon" />
            <div class="details-body">
                <ul>
                    <li><strong>In person:</strong> registration closes on December 12, 2026</li>
                    <li><strong>Virtual:</strong> registration closes on February 14, 2027</li>
                </ul>
                <a class="register-btn" href={registrationUrl} target="_blank" rel="noopener noreferrer">Register</a>
            </div>
        </SectionCard>
    </section>

    <section class="goals">
        <SectionCard title="Workshop Goals" iconColor="teal">
            <IconTarget slot="icon" />
            <div class="details-body">
                <ul>
                    <li>Introduce the ZAPP annotation tools and teach community members how to use them</li>
                    <li>Collect data for the Atlas through hands-on sessions</li>
                    <li>Gather feedback about the annotation tools and the Atlas</li>
                    <li>Discuss curation guidelines and data governance</li>
                </ul>
            </div>
        </SectionCard>
    </section>

    <section class="attend">
        <SectionCard title="Who Can Attend" iconColor="teal">
            <IconUsers slot="icon" />
            <div class="details-body">
                <p>Anyone in the zebrafish community is welcome to join in person. Some parts of the workshop will also be offered virtually via Zoom, but all hands-on sessions are for in-person participants only.</p>
            </div>
        </SectionCard>
    </section>

    <section class="bring">
        <SectionCard title="What to Bring" iconColor="teal">
            <IconUpload slot="icon" />
            <div class="details-body">
                <p>This is a hands-on workshop. Participants will bring their own images and data and annotate them using the ZAPP annotation tools.</p>
                <ul>
                    <li>Images (phenotypic fish and controls) and information from at least 5 individual chemical treatment experiments (different chemicals and/or different concentrations)</li>
                    <li>Data can be already published or new data that has not yet been made public</li>
                    <li>You decide whether to publish your data in the publicly accessible Atlas or keep it unpublished within the annotation tool platform. See our <a href="https://zappfish.org/ZAPPGovernance/data-governance/">data governance rules</a> for how data sharing and ownership work.</li>
                </ul>
            </div>
        </SectionCard>
    </section>

    <section class="travel">
        <SectionCard title="Travel and Lodging" iconColor="teal">
            <IconMap slot="icon" />
            <div class="details-body">
                <p>If traveling by plane, fly into Denver International Airport (DEN), then take a taxi or rideshare (such as Uber) to the Anschutz campus.</p>
                <p>Suggested hotels close to campus:</p>
                <ul>
                    <li><a href="https://www.thebensonhotel.com/" target="_blank" rel="noopener noreferrer">The Benson Hotel &amp; Faculty Club</a>: on campus, with a complimentary golf cart shuttle around campus (13025 E Montview Blvd)</li>
                    <li><a href="https://www.marriott.com/denaf" target="_blank" rel="noopener noreferrer">SpringHill Suites Denver at Anschutz Medical Campus</a>: about a 5-10 minute walk to campus (13400 E Colfax Ave)</li>
                    <li><a href="https://www.hyatt.com/hyatt-house/en-US/denxo-hyatt-house-denver-aurora-anschutz-medical-campus" target="_blank" rel="noopener noreferrer">Hyatt House Denver Aurora Anschutz Medical Campus</a>: across Colfax Ave from campus, a few minutes' walk (12230 E Colfax Ave)</li>
                </ul>
            </div>
        </SectionCard>
    </section>

    <section class="schedule">
        <SectionCard title="Workshop Schedule" iconColor="teal">
            <IconCalendar slot="icon" />
            <div class="details-body">
                <p>Coming soon.</p>
            </div>
        </SectionCard>
    </section>

    <section class="resources">
        <SectionCard title="Workshop Material and Resources" iconColor="teal">
            <IconFileText slot="icon" />
            <div class="details-body">
                <ul>
                    <li><a href="https://docs.google.com/document/d/1HRDuhKquGIEclo37bmxQUJXNiXWVmxRZtieWLmcmzCU/edit?usp=sharing" target="_blank" rel="noopener noreferrer">Information required for data annotation</a></li>
                    <li><a href="https://zappfish.org/ZAPPGovernance/data-governance/">Data governance</a>: current rules about data sharing, data ownership, and data governance</li>
                    <li><a href="https://zappfish.org/ZAPPGovernance/code-of-conduct/">Code of conduct</a></li>
                </ul>
            </div>
        </SectionCard>
    </section>

    <section class="action-cards">
        <ActionCard
            title="All Events"
            description="See all upcoming and past ZAPP workshops and meetings."
            href="/events"
            linkLabel="View Events"
        >
            <IconCalendar slot="icon" />
        </ActionCard>
        <ActionCard
            title="Questions?"
            description="Get in touch with the ZAPP team about the workshop."
            href="/contact"
            linkLabel="Contact Us"
        >
            <IconMail slot="icon" />
        </ActionCard>
    </section>

</Main>

<style>
    /* links — match link style on the Goals page */
    .about a,
    .details-body a:not(.register-btn) {
        text-decoration: none;
        color: var(--color-accent);
        font-weight: var(--font-weight-bold);
        transition: color var(--transition-fast);
    }
    .about a:hover,
    .details-body a:not(.register-btn):hover {
        color: var(--color-accent-hover);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    /* card body */
    .details-body { padding: var(--space-8); }
    .details-body p { margin-bottom: var(--space-4); }
    .details-body p:last-child { margin-bottom: 0; }
    .details-body ul { padding-left: var(--space-4); margin-bottom: 0; }
    .details-body li { margin-bottom: var(--space-3); }
    .details-body li:last-child { margin-bottom: 0; }

    /* register button — matches the Sign Up button on the Events page */
    .register-btn {
        display: inline-block;
        margin-top: var(--space-6);
        padding: var(--space-3) var(--space-6);
        background: var(--color-accent);
        color: var(--color-text-white);
        border-radius: 6px;
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        text-decoration: none;
        transition: background 0.15s;
    }
    .register-btn:hover { background: var(--color-accent-hover); }

    /* action cards grid — layout lives here, card styles live in ActionCard.astro */
    .action-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }

    @media (max-width: 768px) {
        .details-body { padding: var(--space-6); }
        .action-cards { grid-template-columns: 1fr; }
    }
</style>
